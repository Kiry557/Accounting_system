import pandas as pd
import streamlit as st

from database.repository import insert_item, select_item

st.set_page_config(
    page_title="SRW — склад",
    page_icon="📦",
    layout="wide",
)

st.title("SRW — система складского учёта")
st.caption("Управление карточками товаров")

if "page" not in st.session_state:
    st.session_state.page = "see"

col1, col2 = st.columns(2)

with col1:
    if st.button("See — посмотреть карточки", use_container_width=True):
        st.session_state.page = "see"

with col2:
    if st.button("Write — добавить товар", use_container_width=True):
        st.session_state.page = "write"

st.divider()

# SEE: просмотр всех карточек
if st.session_state.page == "see":
    st.subheader("Все карточки товаров")

    if st.button("Обновить список"):
        st.rerun()

    items = select_item()

    if isinstance(items, str):
        st.error(items)

    elif not items:
        st.info("Карточек товаров пока нет.")

    else:
        columns = [
            "ID",
            "Название",
            "Категория",
            "Единица измерения",
            "Критический остаток",
            "Текущий остаток",
        ]

        df = pd.DataFrame(items, columns=columns)

        st.dataframe(
            df,
            use_container_width=True,
            hide_index=True,
        )

# WRITE: создание карточки товара
elif st.session_state.page == "write":
    st.subheader("Новая карточка товара")

    with st.form("item_form", clear_on_submit=True):
        name = st.text_input(
            "Название товара",
            placeholder="Например, Болт M8",
        )

        category = st.text_input(
            "Категория",
            placeholder="Например, Крепёж",
        )

        unit = st.text_input(
            "Единица измерения",
            placeholder="шт., кг, м",
        )

        critical_balance = st.number_input(
            "Критический остаток",
            min_value=0,
            value=0,
            step=1,
        )

        submitted = st.form_submit_button(
            "Добавить товар",
            type="primary",
        )

    if submitted:
        if not name.strip() or not category.strip() or not unit.strip():
            st.warning("Заполните все текстовые поля.")

        else:
            result = insert_item(
                name=name.strip(),
                category=category.strip(),
                unit=unit.strip(),
                critical_balance=int(critical_balance),
            )

            if isinstance(result, str) and result.startswith(
                "Карточка товара успешно добавлена"
            ):
                st.success(result)
            else:
                st.error(result)
